# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=unbound

# Docker image
IMAGE=ghcr.io/zyrakq/unbound:latest
# IMAGE=glocalhost/unbound:latest
# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Unbound DNS Server Configuration

# Access Control - allow localhost and Docker networks
ACCESS_CONTROL_CUSTOM="127.0.0.0/8 allow,172.16.0.0/12 allow,0.0.0.0/0 deny"

# Stub Zones - forward *.local to docker-gen-dns
STUB_ZONES="local:127.0.0.1:5353,test:127.0.0.1:53"

BLOCK_PRIVATE=false
ENABLE_DNSSEC=true
ENABLE_CACHE=true

